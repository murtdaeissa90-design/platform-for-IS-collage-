*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,sans-serif;
    background:#f4f7fb;
    color:#222;
    transition:.3s;
}

header{
    background:#173b67;
    color:white;
    text-align:center;
    padding:45px 20px;
}

header h1{
    font-family:'Poppins','Cairo',Arial,sans-serif;
    font-size:38px;
    font-weight:700;
    letter-spacing:1px;
    margin-bottom:14px;
    text-shadow:0 2px 10px rgba(0,0,0,.25);
}

[dir=rtl] header h1{
    font-family:'Cairo','Poppins',Arial,sans-serif;
    letter-spacing:0;
}

header p{
    margin:6px;
}

nav{
    background:white;
    padding:15px;
    text-align:center;
    box-shadow:0 2px 10px #ddd;
}

nav button{
    background:none;
    border:none;
    color:#173b67;
    font-size:16px;
    font-weight:bold;
    margin:8px 15px;
    cursor:pointer;
}

.search{
    max-width:650px;
    margin:25px auto;
    padding:0 20px;
}

.search input{
    width:100%;
    padding:15px 20px;
    border:0;
    border-radius:30px;
    font-size:16px;
    box-shadow:0 4px 15px #ddd;
    outline:none;
}

.container{
    max-width:1150px;
    margin:auto;
    padding:35px 20px;
}

.title{
    text-align:center;
    margin-bottom:30px;
}

.title h2{
    color:#173b67;
    margin-bottom:10px;
}

.subjects{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(230px,1fr));
    gap:22px;
}

.subject{
    position:relative;
    background:white;
    padding:28px 20px;
    border-radius:18px;
    text-align:center;
    box-shadow:0 5px 15px #ddd;
    cursor:pointer;
    transition:.3s;
}

.subject:hover{
    transform:translateY(-6px);
}

.term-switch{
    display:flex;
    justify-content:center;
    gap:10px;
    margin-bottom:18px;
    flex-wrap:wrap;
}

.term-btn{
    padding:10px 20px;
    border:2px solid #173b67;
    border-radius:25px;
    background:white;
    color:#173b67;
    font-weight:bold;
    cursor:pointer;
}

.term-btn.active{
    background:#173b67;
    color:white;
}

body.dark .term-btn:not(.active){
    background:#1e1e1e;
    color:white;
    border-color:#555;
}

.fav-star{
    position:absolute;
    top:10px;
    inset-inline-end:12px;
    font-size:20px;
    cursor:pointer;
    opacity:.35;
    z-index:2;
}

.fav-star.active{
    opacity:1;
}

.exam-card{
    background:white;
    padding:16px 18px;
    border-radius:14px;
    box-shadow:0 3px 10px #ddd;
    margin-bottom:20px;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:10px;
}

.exam-card span{
    flex:1;
    min-width:160px;
    font-weight:bold;
}

.exam-card.urgent span{
    color:#c0392b;
}

.exam-card input[type=date]{
    padding:8px 10px;
    border-radius:8px;
    border:1px solid #ccc;
}

.exam-card button{
    background:#173b67;
    color:white;
    border:0;
    padding:8px 16px;
    border-radius:8px;
    cursor:pointer;
}

#examClearBtn{
    background:#888;
}

.file-search{
    width:100%;
    padding:12px 15px;
    border-radius:8px;
    border:1px solid #ccc;
    font-size:15px;
    margin-bottom:15px;
}

body.dark .exam-card{
    background:#1e1e1e;
    color:white;
}

body.dark .file-search{
    background:#222;
    color:white;
    border-color:#444;
}

.icon{
    font-size:45px;
    margin-bottom:12px;
}

.subject h3{
    color:#173b67;
    margin-bottom:10px;
}

.subject p{
    color:#777;
    font-size:14px;
}

#subjectPage,
#materialsPage,
#aboutPage{
    display:none;
}

.back{
    background:#173b67;
    color:white;
    border:0;
    padding:12px 20px;
    border-radius:10px;
    cursor:pointer;
    margin-bottom:25px;
}

.subject-title{
    background:white;
    text-align:center;
    padding:30px;
    border-radius:18px;
    box-shadow:0 5px 15px #ddd;
    margin-bottom:30px;
}

.subject-title h2{
    color:#173b67;
}

.materials{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));
    gap:22px;
}

.material{
    background:white;
    padding:30px;
    border-radius:18px;
    text-align:center;
    box-shadow:0 5px 15px #ddd;
    cursor:pointer;
    transition:.3s;
}

.material:hover{
    transform:translateY(-6px);
}

.material-icon{
    font-size:45px;
    margin-bottom:15px;
}

.material h3{
    color:#173b67;
    margin-bottom:10px;
}

/* جداول أسئلة الاختيار من متعدد */
.mcq-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 10px #ddd;
    margin-bottom: 20px;
}

.mcq-table th, .mcq-table td {
    padding: 15px;
    border-bottom: 1px solid #eee;
    text-align: start;
}

.mcq-table th {
    background: #173b67;
    color: white;
}

.option-btn {
    display: block;
    width: 100%;
    padding: 9px 12px;
    margin: 6px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #f9f9f9;
    cursor: pointer;
    text-align: start;
    font-size: 14px;
    transition: 0.2s;
}

.option-btn:hover:not(:disabled) {
    background: #e9e9e9;
}

body.dark .mcq-table {
    background: #1f1f1f;
    color: white;
}

body.dark .mcq-table td, body.dark .mcq-table th {
    border-bottom-color: #444;
}

body.dark .option-btn {
    background: #2a2a2a;
    color: white;
    border-color: #444;
}

body.dark .option-btn:hover:not(:disabled) {
    background: #3a3a3a;
}

/* بطاقة رفع الملفات */
.upload-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 3px 10px #ddd;
    margin-bottom: 25px;
    text-align: center;
}

.upload-card h3 {
    color: #173b67;
    margin-bottom: 15px;
}

.file-list{
    display:grid;
    gap:15px;
}

.file{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 3px 10px #ddd;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.file button{
    background:#173b67;
    color:white;
    border:0;
    padding:10px 18px;
    border-radius:8px;
    cursor:pointer;
}

.task-add{
    display:flex;
    gap:10px;
    margin-bottom:20px;
}

.task-add input{
    flex:1;
    padding:12px 15px;
    border-radius:8px;
    border:1px solid #ccc;
    font-size:15px;
}

.task-add button{
    background:#173b67;
    color:white;
    border:0;
    padding:12px 20px;
    border-radius:8px;
    cursor:pointer;
}

.task-list{
    list-style:none;
    display:grid;
    gap:12px;
}

.task-list li{
    background:white;
    padding:15px 18px;
    border-radius:10px;
    box-shadow:0 3px 10px #ddd;
    display:flex;
    align-items:center;
    gap:12px;
}

.task-list li.done span{
    text-decoration:line-through;
    color:#888;
}

.task-list li span{
    flex:1;
    cursor:pointer;
}

.task-list li button{
    background:#c0392b;
    color:white;
    border:0;
    width:30px;
    height:30px;
    border-radius:50%;
    cursor:pointer;
    font-size:14px;
}

body.dark .task-add input{
    background:#222;
    color:white;
    border-color:#444;
}

body.dark .task-list li{
    background:#1e1e1e;
    color:white;
}

.empty{
    background:white;
    padding:30px;
    text-align:center;
    border-radius:15px;
    color:#777;
}

.upload-card input[type=file]{
    display:block;
    width:100%;
    margin-bottom:12px;
    font-size:14px;
}

.upload-card button{
    background:#173b67;
    color:white;
    border:0;
    padding:10px 20px;
    border-radius:8px;
    cursor:pointer;
}

.upload-card button:disabled{
    opacity:.6;
    cursor:not-allowed;
}

.msg{
    margin-top:10px;
    padding:10px 14px;
    border-radius:8px;
    background:#e8f5e9;
    color:#1b5e20;
    display:none;
}

.msg.err{
    background:#fdecea;
    color:#b71c1c;
}

body.dark .upload-card{
    background:#1e1e1e;
    color:white;
}

.about{
    background:white;
    padding:35px;
    border-radius:18px;
    text-align:center;
    box-shadow:0 5px 15px #ddd;
    line-height:1.8;
}

.counter{
    text-align:center;
    margin:20px 0;
    color:#777;
}

.dark{
    background:#121212;
    color:white;
}

.dark nav,
.dark .subject,
.dark .material,
.dark .file,
.dark .subject-title,
.dark .about,
.dark .empty,
.dark .upload-card {
    background:#1f1f1f;
    color:white;
}

.dark .subject h3,
.dark .material h3,
.dark .subject-title h2,
.dark .title h2,
.dark .upload-card h3 {
    color:#7db7ff;
}

.dark nav button{
    color:#7db7ff;
}

.dark .search input{
    background:#222;
    color:white;
}

footer{
    margin-top:50px;
    background:#173b67;
    color:white;
    text-align:center;
    padding:25px;
}

footer p{
    margin:7px;
}

footer .contact{
    font-weight:600;
    letter-spacing:.3px;
}

@media(max-width:600px){

    header h1{
        font-size:27px;
    }

    nav button{
        display:block;
        margin:12px auto;
    }

    .file{
        flex-direction:column;
        gap:15px;
        text-align:center;
    }

}

.page{display:none}
.msg{max-width:650px;margin:10px auto;padding:12px 16px;border-radius:12px;background:#e8f5e9;color:#1b5e20;text-align:center;display:none}
.msg.err{background:#fdecea;color:#b71c1c}
[dir=rtl] .file{flex-direction:row-reverse}
