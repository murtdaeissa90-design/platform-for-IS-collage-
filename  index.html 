 let taps = 0, timer = null;
 $("footerLogo").addEventListener("click", ()=>{
  taps++;
  clearTimeout(timer);
  timer = setTimeout(()=>{ taps = 0; }, 3000);
  if(taps >= 5){
   taps = 0;
   $("adminLink").style.display = "inline-block";
  }
 });
})();

applyLang();
restoreDarkMode();
show("homePage");
</script>
