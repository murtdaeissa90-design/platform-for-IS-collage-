<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Students IS Education Platform</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
    --navy:#173b67;
    --navy-deep:#0f2a4a;
    --teal:#16806a;
    --gold:#e3b04b;
    --bg:#f2f5fa;
    --card:#ffffff;
    --text:#1d2733;
    --muted:#6b7686;
    --line:#e3e9f2;
    --accent:#173b67;
    --input-bg:#ffffff;
    --shadow:0 2px 8px rgba(23,59,103,.10);
    --shadow-hover:0 4px 12px rgba(23,59,103,.16);
}
body.dark{
    --bg:#0f141b;
    --card:#1a212b;
    --text:#eef2f7;
    --muted:#9aa6b6;
    --line:#2a3340;
    --accent:#7db7ff;
    --input-bg:#222b37;
    --shadow:0 2px 8px rgba(0,0,0,.45);
    --shadow-hover:0 4px 12px rgba(0,0,0,.55);
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:auto;}
body{
    font-family:'Poppins','Cairo',Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.6;
    transition:background .3s,color .3s;
}
[dir=rtl] body{font-family:'Cairo','Poppins',Arial,sans-serif;}

/* Header */
header{
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 12% 20%,rgba(227,176,75,.22),transparent 38%),
        radial-gradient(circle at 90% 80%,rgba(22,128,106,.35),transparent 42%),
        linear-gradient(135deg,var(--navy-deep),var(--navy));
    color:white;
    text-align:center;
    padding:56px 20px 70px;
    border-radius:0 0 36px 36px;
    box-shadow:0 10px 30px rgba(15,42,74,.25);
}
header::after{
    content:"";
    position:absolute;
    inset:0;
    background-image:radial-gradient(rgba(255,255,255,.07) 1px,transparent 1px);
    background-size:22px 22px;
    pointer-events:none;
}
header > *{position:relative;z-index:1;}
header h1{
    font-size:40px;
    font-weight:700;
    letter-spacing:.5px;
    margin-bottom:16px;
    text-shadow:0 3px 14px rgba(0,0,0,.3);
}
[dir=rtl] header h1{letter-spacing:0;}
header p{margin:6px;font-size:16px;color:rgba(255,255,255,.88);}
header p:nth-of-type(1){
    display:inline-block;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.25);
    padding:6px 20px;
    border-radius:30px;
    font-weight:600;
    color:#fff;
}

/* Nav */
nav{
    position:sticky;
    top:14px;
    z-index:20;
    width:fit-content;
    max-width:calc(100% - 24px);
    margin:-30px auto 0;
    background:var(--card);
    padding:8px 12px;
    text-align:center;
    border-radius:50px;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
}
nav button{
    background:none;
    border:none;
    color:var(--accent);
    font-family:inherit;
    font-size:15px;
    font-weight:600;
    margin:3px 4px;
    padding:9px 18px;
    border-radius:30px;
    cursor:pointer;
    transition:background .25s,color .25s,transform .2s;
}
nav button:hover{background:var(--navy);color:#fff;}
nav button:active{transform:scale(.96);}
body.dark nav button:hover{background:#7db7ff;color:#0f141b;}

/* Search */
.search{max-width:650px;margin:32px auto 10px;padding:0 20px;}
.search input{
    width:100%;
    padding:16px 24px;
    border:2px solid transparent;
    border-radius:30px;
    font-family:inherit;
    font-size:16px;
    background:var(--card);
    color:var(--text);
    box-shadow:var(--shadow);
    outline:none;
    transition:border-color .25s,box-shadow .25s;
}
.search input:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(23,59,103,.12);}
.search input::placeholder{color:var(--muted);}

/* Containers */
.container{max-width:1150px;margin:auto;padding:35px 20px;}
.page{display:none;}
.title{text-align:center;margin-bottom:12px;}
.title h2{color:var(--accent);font-size:28px;font-weight:700;margin-bottom:10px;}
.title h2::after{
    content:"";
    display:block;
    width:60px;
    height:4px;
    margin:12px auto 0;
    border-radius:4px;
    background:linear-gradient(90deg,var(--navy),var(--teal));
}
.counter{text-align:center;margin:14px 0 22px;color:var(--muted);font-size:15px;font-weight:500;}

/* Semester tabs */
.semester-tabs{
    display:flex;
    justify-content:center;
    gap:8px;
    flex-wrap:wrap;
    width:fit-content;
    max-width:100%;
    margin:0 auto 26px;
    padding:6px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:50px;
    box-shadow:var(--shadow);
}
.sem-btn{
    background:none;
    border:0;
    color:var(--accent);
    font-family:inherit;
    font-size:15px;
    font-weight:600;
    padding:11px 26px;
    border-radius:40px;
    cursor:pointer;
    transition:background .25s,color .25s,box-shadow .25s;
}
.sem-btn:hover:not(.active){background:rgba(23,59,103,.08);}
.sem-btn.active{
    background:linear-gradient(135deg,var(--navy),var(--teal));
    color:#fff;
    box-shadow:0 4px 12px rgba(23,59,103,.28);
}

/* Subjects */
.subjects{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px;}
.subject{
    position:relative;
    overflow:hidden;
    background:var(--card);
    padding:30px 20px 26px;
    border-radius:20px;
    border:1px solid var(--line);
    text-align:center;
    box-shadow:var(--shadow);
    cursor:pointer;
    transition:transform .3s,box-shadow .3s,border-color .3s;
}
.subject::before{
    content:"";
    position:absolute;
    top:0;left:0;right:0;
    height:5px;
    background:linear-gradient(90deg,var(--navy),var(--teal));
    opacity:.85;
}
.subject:hover{transform:translateY(-6px);box-shadow:var(--shadow-hover);border-color:var(--accent);}
.icon,.material-icon{
    width:78px;height:78px;
    margin:0 auto 16px;
    display:flex;align-items:center;justify-content:center;
    font-size:38px;
    border-radius:22px;
    background:linear-gradient(135deg,rgba(23,59,103,.10),rgba(22,128,106,.12));
}
.subject h3{color:var(--accent);font-size:17px;font-weight:600;margin-bottom:10px;}
.fav-star{
    position:absolute;
    top:14px;
    inset-inline-end:14px;
    font-size:20px;
    cursor:pointer;
    opacity:.4;
    z-index:2;
    transition:opacity .2s,transform .2s;
}
.fav-star:hover{transform:scale(1.2);}
.fav-star.active{opacity:1;}

/* Buttons */
.back{
    background:var(--navy);
    color:white;
    border:0;
    padding:12px 24px;
    border-radius:12px;
    font-family:inherit;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
    margin-bottom:25px;
    box-shadow:0 4px 12px rgba(23,59,103,.25);
    transition:transform .2s,box-shadow .2s;
}
.back:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(23,59,103,.32);}

.subject-title{
    background:var(--card);
    text-align:center;
    padding:30px;
    border-radius:20px;
    border:1px solid var(--line);
    border-inline-start:6px solid var(--teal);
    box-shadow:var(--shadow);
    margin-bottom:30px;
}
.subject-title h2{color:var(--accent);font-size:26px;}

/* Exam card */
.exam-card{
    background:var(--card);
    padding:16px 20px;
    border-radius:16px;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    margin-bottom:26px;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:10px;
}
.exam-card span{flex:1;min-width:170px;font-weight:600;}
.exam-card.urgent{border-color:#c0392b;}
.exam-card.urgent span{color:#c0392b;}
.exam-card input[type=date]{
    padding:9px 12px;
    border-radius:10px;
    border:1px solid var(--line);
    background:var(--input-bg);
    color:var(--text);
    font-family:inherit;
}
.exam-card button{
    background:var(--navy);
    color:#fff;
    border:0;
    padding:9px 18px;
    border-radius:10px;
    font-family:inherit;
    font-weight:600;
    cursor:pointer;
}
#examClearBtn{background:#7b8794;}

/* Materials */
.materials{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;}
.material{
    background:var(--card);
    padding:32px 24px;
    border-radius:20px;
    border:1px solid var(--line);
    text-align:center;
    box-shadow:var(--shadow);
    cursor:pointer;
    transition:transform .3s,box-shadow .3s,border-color .3s;
}
.material:hover{transform:translateY(-6px);box-shadow:var(--shadow-hover);border-color:var(--accent);}
.material h3{color:var(--accent);margin-bottom:8px;}
.material p{color:var(--muted);font-size:14px;}

/* Upload card */
.upload-card{
    background:var(--card);
    padding:22px;
    border-radius:18px;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    margin-bottom:22px;
    text-align:center;
}
.upload-card h3{color:var(--accent);margin-bottom:14px;font-size:17px;}
.upload-card input[type=file]{
    display:block;
    width:100%;
    margin-bottom:12px;
    font-family:inherit;
    font-size:14px;
    color:var(--text);
}
.upload-card button{
    background:var(--navy);
    color:#fff;
    border:0;
    padding:10px 26px;
    border-radius:10px;
    font-family:inherit;
    font-weight:600;
    cursor:pointer;
}
.upload-card button:hover{background:var(--teal);}
.upload-card button:disabled{opacity:.6;cursor:not-allowed;}
.msg{
    margin:12px auto 0;
    max-width:650px;
    padding:11px 16px;
    border-radius:12px;
    background:#e8f5e9;
    color:#1b5e20;
    text-align:center;
    display:none;
}
.msg.err{background:#fdecea;color:#b71c1c;}

.file-search{
    width:100%;
    padding:13px 18px;
    border-radius:12px;
    border:1px solid var(--line);
    background:var(--card);
    color:var(--text);
    font-family:inherit;
    font-size:15px;
    margin-bottom:16px;
    outline:none;
}
.file-search:focus{border-color:var(--accent);}

/* Files */
.file-list{display:grid;gap:14px;}
.file{
    background:var(--card);
    padding:18px 22px;
    border-radius:14px;
    border:1px solid var(--line);
    border-inline-start:4px solid var(--navy);
    box-shadow:0 3px 12px rgba(23,59,103,.08);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    transition:transform .25s,box-shadow .25s;
}
.file:hover{transform:translateX(4px);box-shadow:var(--shadow);}
[dir=rtl] .file:hover{transform:translateX(-4px);}
.file span{font-weight:500;word-break:break-word;}
.file button{
    background:var(--navy);
    color:white;
    border:0;
    padding:10px 24px;
    border-radius:10px;
    font-family:inherit;
    font-weight:600;
    cursor:pointer;
    white-space:nowrap;
    transition:background .25s,transform .2s;
}
.file button:hover{background:var(--teal);transform:scale(1.05);}
.empty{
    background:var(--card);
    padding:34px;
    text-align:center;
    border-radius:16px;
    border:2px dashed var(--line);
    color:var(--muted);
}

/* MCQ table */
.mcq-wrap{overflow-x:auto;}
.mcq-table{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:16px;
    overflow:hidden;
    box-shadow:var(--shadow);
}
.mcq-table th,.mcq-table td{
    padding:15px;
    border-bottom:1px solid var(--line);
    text-align:start;
    vertical-align:top;
}
.mcq-table tbody tr:last-child td{border-bottom:0;}
.mcq-table th{background:linear-gradient(135deg,var(--navy-deep),var(--navy));color:#fff;font-weight:600;}
.option-btn{
    display:block;
    width:100%;
    padding:10px 14px;
    margin:6px 0;
    border:1px solid var(--line);
    border-radius:10px;
    background:var(--input-bg);
    color:var(--text);
    cursor:pointer;
    text-align:start;
    font-family:inherit;
    font-size:14px;
    transition:background .2s,border-color .2s;
}
.option-btn:hover:not(:disabled){border-color:var(--accent);background:rgba(23,59,103,.06);}
.option-btn.correct{background:#d4edda;color:#155724;border-color:#c3e6cb;}
.option-btn.wrong{background:#f8d7da;color:#721c24;border-color:#f5c6cb;}
.option-btn:disabled{cursor:default;}

/* Tasks */
.task-add{display:flex;gap:10px;margin-bottom:20px;}
.task-add input{
    flex:1;
    padding:14px 18px;
    border-radius:14px;
    border:1px solid var(--line);
    background:var(--card);
    color:var(--text);
    font-family:inherit;
    font-size:15px;
    outline:none;
}
.task-add input:focus{border-color:var(--accent);}
.task-add button{
    background:var(--navy);
    color:#fff;
    border:0;
    padding:12px 22px;
    border-radius:14px;
    font-family:inherit;
    font-weight:600;
    cursor:pointer;
}
.task-add button:hover{background:var(--teal);}
.task-list{list-style:none;display:grid;gap:12px;margin-bottom:16px;}
.task-list li{
    background:var(--card);
    padding:15px 18px;
    border-radius:14px;
    border:1px solid var(--line);
    border-inline-start:4px solid var(--teal);
    box-shadow:0 3px 12px rgba(23,59,103,.08);
    display:flex;
    align-items:center;
    gap:12px;
}
.task-list li.done span{text-decoration:line-through;color:var(--muted);}
.task-list li span{flex:1;cursor:pointer;word-break:break-word;}
.task-list li button{
    background:#c0392b;
    color:#fff;
    border:0;
    width:30px;height:30px;
    border-radius:50%;
    cursor:pointer;
    font-size:14px;
}

/* About */
.about{
    background:var(--card);
    padding:42px 35px;
    border-radius:22px;
    border:1px solid var(--line);
    text-align:center;
    box-shadow:var(--shadow);
    line-height:1.9;
}
.about h2{color:var(--accent);font-size:28px;}

/* Footer */
footer{
    position:relative;
    margin-top:60px;
    background:linear-gradient(135deg,var(--navy-deep),var(--navy));
    color:white;
    text-align:center;
    padding:42px 20px 28px;
    border-radius:36px 36px 0 0;
}
footer::before{
    content:"";
    display:block;
    width:70px;height:4px;
    margin:0 auto 22px;
    border-radius:4px;
    background:linear-gradient(90deg,var(--gold),var(--teal));
}
footer p{margin:7px;color:rgba(255,255,255,.88);}
footer > p:first-of-type{font-size:19px;font-weight:700;color:#fff;}
footer .contact{font-weight:600;letter-spacing:.3px;line-height:2;}
footer .credits{
    max-width:520px;
    margin:22px auto 8px;
    padding:18px 22px;
    background:rgba(255,255,255,.09);
    border:1px solid rgba(255,255,255,.22);
    border-radius:18px;
}
footer .credits .label{display:block;font-size:14px;color:var(--gold);font-weight:600;margin-bottom:6px;}
footer .credits .names{
    display:block;
    font-family:'Cairo','Poppins',Arial,sans-serif;
    font-size:22px;
    font-weight:800;
    color:#fff;
    letter-spacing:0;
}
footer .credits .names i{font-style:normal;color:var(--gold);margin:0 8px;}
#adminLink{display:none;margin-top:10px;color:#9ec8ff;font-size:13px;}

/* No movement animations (lighter scrolling on phones) */
*{transition:none !important;}
.subject:hover,.material:hover,.file:hover,.back:hover,.file button:hover,.fav-star:hover,nav button:active{transform:none !important;}

/* Accessibility */
button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
@media (prefers-reduced-motion:reduce){
    *{transition:none !important;scroll-behavior:auto !important;}
}

/* Mobile */
@media(max-width:600px){
    header{padding:42px 16px 60px;border-radius:0 0 28px 28px;}
    header h1{font-size:27px;}
    nav{border-radius:26px;padding:6px;}
    nav button{display:inline-block;margin:3px;padding:8px 12px;font-size:14px;}
    .file{flex-direction:column;text-align:center;}
    .file button{width:100%;}
    .sem-btn{padding:10px 16px;font-size:14px;}
    footer{border-radius:28px 28px 0 0;}
    footer .credits .names{font-size:19px;}
}
[dir=rtl] .file{flex-direction:row-reverse;}
@media(max-width:600px){[dir=rtl] .file{flex-direction:column;}}
</style>
</head>

<body>

<header>
    <h1 data-en="🎓 Students IS Education Platform" data-ar="🎓 منصة Students IS التعليمية">🎓 Students IS Education Platform</h1>
    <p data-en="Al-Bayan University" data-ar="جامعة البيان">Al-Bayan University</p>
    <p data-en="College of Computer Science & IT" data-ar="كلية علوم الحاسوب وتقانة المعلومات">College of Computer Science & IT</p>
    <p data-en="Information Systems Department" data-ar="قسم نظم المعلومات">Information Systems Department</p>
</header>

<nav>
    <button id="navHome" data-en="🏠 Home" data-ar="🏠 الرئيسية">🏠 Home</button>
    <button id="navTasks" data-en="📝 Tasks" data-ar="📝 مهامي">📝 Tasks</button>
    <button id="navAbout" data-en="ℹ️ About" data-ar="ℹ️ حول المنصة">ℹ️ About</button>
    <button id="navDark">🌙</button>
    <button id="navLang">عربي</button>
</nav>

<div class="search">
    <input id="searchInput" type="text" placeholder="🔎 Search for a subject..."
           data-en="🔎 Search for a subject..." data-ar="🔎 ابحث عن مادة أو ملف..." data-ph="1">
</div>

<!-- Home -->
<section id="homePage" class="page">
    <div class="container">
        <div class="semester-tabs">
            <button class="sem-btn active" id="sem3Btn" type="button" onclick="switchSemester('semester3')"></button>
            <button class="sem-btn" id="sem2Btn" type="button" onclick="switchSemester('semester2')"></button>
        </div>
        <div class="title"><h2 id="semesterTitle"></h2></div>
        <div class="counter" id="counter"></div>
        <div class="subjects" id="subjectList"></div>
    </div>
</section>

<!-- Tasks -->
<section id="tasksPage" class="page">
    <div class="container">
        <div class="title"><h2 data-en="📝 My Study Tasks" data-ar="📝 مهام مذاكرتي">📝 My Study Tasks</h2></div>
        <div class="task-add">
            <input type="text" id="taskInput" placeholder="Write a new task..." data-en="Write a new task..." data-ar="اكتب مهمة جديدة..." data-ph="1">
            <button id="addTaskBtn" data-en="➕ Add" data-ar="➕ إضافة">➕ Add</button>
        </div>
        <ul id="taskList" class="task-list"></ul>
        <p class="empty" id="taskEmpty" data-en="No tasks yet. Add your first one above 👆" data-ar="لا توجد مهام بعد. أضف أول مهمة من الأعلى 👆">No tasks yet. Add your first one above 👆</p>
    </div>
</section>

<!-- Subject -->
<section id="subjectPage" class="page">
    <div class="container">
        <button class="back" id="backHome" data-en="← Back" data-ar="→ رجوع">← Back</button>
        <div class="subject-title"><h2 id="subjectName"></h2></div>

        <div class="exam-card">
            <span id="examText" data-en="⏳ No exam date set" data-ar="⏳ لم يُحدد موعد امتحان">⏳ No exam date set</span>
            <input type="date" id="examDate">
            <button id="examSaveBtn" data-en="Save" data-ar="حفظ">Save</button>
            <button id="examClearBtn" data-en="Clear" data-ar="مسح">Clear</button>
        </div>

        <div class="materials" id="materialList"></div>
    </div>
</section>

<!-- Materials -->
<section id="materialsPage" class="page">
    <div class="container">
        <button class="back" id="backSubject" data-en="← Back" data-ar="→ رجوع">← Back</button>
        <div class="subject-title"><h2 id="materialTitle"></h2></div>

        <div class="upload-card" id="uploadCardSection">
            <h3 data-en="📤 Upload a File (reviewed before publishing)" data-ar="📤 رفع ملف (يُنشر بعد المراجعة)">📤 Upload a File (reviewed before publishing)</h3>
            <input type="file" id="uploadInput" accept="application/pdf,.doc,.docx,.ppt,.pptx,image/*">
            <button id="uploadBtn" data-en="Upload" data-ar="رفع">Upload</button>
            <div class="msg" id="uploadMsg"></div>
        </div>

        <input type="text" id="fileSearchInput" class="file-search" placeholder="🔎 Search files in this section..."
               data-en="🔎 Search files in this section..." data-ar="🔎 ابحث في هذا القسم..." data-ph="1">
        <div id="fileList" class="file-list"></div>
    </div>
</section>

<!-- About -->
<section id="aboutPage" class="page">
