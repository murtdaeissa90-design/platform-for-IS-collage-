/* ===== Helpers ===== */
const $ = id => document.getElementById(id);
let lang = "en", subject = "", material = "";
const cache = {};
const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
const pages = ["homePage","tasksPage","subjectPage","materialsPage","aboutPage"];
function show(id){ pages.forEach(p => $(p).style.display = p===id ? "block" : "none"); }
const sb = window.supabase ? window.supabase.createClient(STORAGE_URL, STORAGE_KEY) : null;
const folderOf = name => {
 const allSubs = [...SEMESTERS.semester3.subjects, ...SEMESTERS.semester2.subjects];
 const found = allSubs.find(s => s[0]===name);
 return found ? found[2] : name;
};

/* ===== Storage ===== */
async function listFiles(path){
 const {data,error} = await sb.storage.from(BUCKET).list(path,{limit:200,sortBy:{column:"name",order:"asc"}});
 if(error) throw error;
 return (data||[]).filter(f => f.id && f.name !== ".emptyFolderPlaceholder").map(f => ({
  name: f.name.replace(/\.[^.]+$/,""),
  url: sb.storage.from(BUCKET).getPublicUrl(path+"/"+f.name).data.publicUrl
 }));
}
async function loadFiles(){
 const key = subject+"|"+material;
 if(cache[key]) return cache[key];
 const fixed = (STATIC[subject] && STATIC[subject][material]) || [];
 let listed = [], approved = [];
 if(sb && !STORAGE_KEY.startsWith("PASTE")){
  try{
   const folder = folderOf(subject);
   listed = await listFiles(folder+"/"+material);
   if(material==="Lectures") listed = listed.concat(await listFiles(folder));
  }catch(e){ console.error(e); if(!fixed.length) throw e; }
  try{
   const {data,error} = await sb.from("submissions").select("name,path").eq("subject",subject).eq("material",material).eq("approved",true);
   if(!error) approved = (data||[]).map(r=>({name:r.name,url:r.path}));
  }catch(e){ console.error("Could not load approved submissions:",e); }
 }
 const all = fixed.concat(listed, approved);
 const seen = new Set(); const out = [];
 all.forEach(f=>{ if(!seen.has(f.url)){ seen.add(f.url); out.push(f); } });
 return cache[key] = out;
}

/* ===== Student upload ===== */
async function uploadFile(){
 const input = $("uploadInput"), btn = $("uploadBtn");
 const file = input.files[0];
 if(!file) return;
 if(!sb || STORAGE_KEY.startsWith("PASTE")){
  note(lang==="ar"?"الرفع غير مفعّل بعد.":"Upload is not enabled yet.", true); return;
 }
 btn.disabled = true;
 note(lang==="ar"?"جارٍ الرفع...":"Uploading...", false);
 try{
  const safeName = file.name.replace(/[^\w.\-]+/g,"_");
  const path = "pending/"+Date.now()+"_"+safeName;
  const {error: upErr} = await sb.storage.from(BUCKET).upload(path, file);
  if(upErr) throw upErr;
  const url = sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
  const {error: insErr} = await sb.from("submissions").insert([{
   subject, material, name: file.name.replace(/\.[^.]+$/,"").slice(0,120), path: url, approved:false
  }]);
  if(insErr) throw insErr;
  note(lang==="ar"?"تم الرفع، سيظهر بعد موافقة الأدمن ✅":"Uploaded. It will appear after admin approval ✅", false);
  input.value = "";
 }catch(e){
  console.error(e);
  note(lang==="ar"?"تعذر رفع الملف.":"Could not upload the file.", true);
 }finally{
  btn.disabled = false;
 }
}
function note(text, err){
 const m = $("uploadMsg");
 m.textContent = text; m.className = "msg"+(err?" err":""); m.style.display = "block";
 setTimeout(()=>{ m.style.display = "none"; }, 6000);
}

/* ===== Favorites ===== */
const FAV_KEY = "fav_subjects";
function loadFavs(){
 try{ return JSON.parse(localStorage.getItem(FAV_KEY)) || []; }
 catch{ return []; }
}
function saveFavs(list){
 try{ localStorage.setItem(FAV_KEY, JSON.stringify(list)); }
 catch(e){ console.error("Could not save favorites:", e); }
}
function toggleFav(name){
 const favs = loadFavs();
 const i = favs.indexOf(name);
 if(i===-1) favs.push(name); else favs.splice(i,1);
 saveFavs(favs);
 renderSubjects();
}

function renderSubjects(){
 const list=$("subjectList"); list.replaceChildren();
 const favs = loadFavs();
 const activeSubs = getActiveSubjects();
 const ordered = [...activeSubs].sort((a,b)=> favs.includes(b[0]) - favs.includes(a[0]));
 ordered.forEach(([name,icon])=>{
  const c=el("div","subject");
  const star=el("span","fav-star"+(favs.includes(name)?" active":""),favs.includes(name)?"⭐":"☆");
  star.addEventListener("click", e=>{ e.stopPropagation(); toggleFav(name); });
  c.append(star, el("div","icon",icon), el("h3","",name));
  c.addEventListener("click",()=>openSubject(name)); list.append(c);
 });
 $("counter").textContent = lang==="ar" ? activeSubs.length+" مواد دراسية" : activeSubs.length+" Academic Subjects";
}

/* ===== Exam countdown ===== */
const EXAM_KEY = "exam_dates";
function loadExamDates(){
 try{ return JSON.parse(localStorage.getItem(EXAM_KEY)) || {}; }
 catch{ return {}; }
}
function saveExamDates(obj){
 try{ localStorage.setItem(EXAM_KEY, JSON.stringify(obj)); }
 catch(e){ console.error("Could not save exam date:", e); }
}
function renderExamCountdown(){
 const dates = loadExamDates();
 const dateStr = dates[subject] || "";
 $("examDate").value = dateStr;
 const card = $("examDate").closest(".exam-card");
 const textEl = $("examText");
 if(!dateStr){
  textEl.textContent = lang==="ar" ? "⏳ لم يُحدد موعد امتحان" : "⏳ No exam date set";
  card.classList.remove("urgent");
  return;
 }
 const today = new Date(); today.setHours(0,0,0,0);
 const examDay = new Date(dateStr+"T00:00:00");
 const days = Math.round((examDay - today) / 86400000);
 card.classList.toggle("urgent", days>=0 && days<=2);
 if(days < 0) textEl.textContent = lang==="ar" ? "✅ انتهى موعد هذا الامتحان" : "✅ This exam date has passed";
 else if(days === 0) textEl.textContent = lang==="ar" ? "🚨 الامتحان اليوم!" : "🚨 Exam is today!";
 else textEl.textContent = (lang==="ar" ? "⏳ باقي "+days+" يوم على الامتحان" : "⏳ "+days+" day(s) left until the exam");
}

function openSubject(name, restore){
 subject=name; $("subjectName").textContent="📚 "+name;
 renderExamCountdown();
 const list=$("materialList"); list.replaceChildren();
 MATERIALS.forEach(([key,icon,en,ar])=>{
  const c=el("div","material"); c.append(el("div","material-icon",icon), el("h3","",lang==="ar"?ar:key), el("p","",lang==="ar"?ar:en));
  c.addEventListener("click",()=>openMaterial(key)); list.append(c);
 });
 show("subjectPage", restore);
}

async function openMaterial(key){
 material=key;
 const isAr = (lang === "ar");
 $("materialTitle").textContent = subject + " - " + (key==="Questions" ? (isAr ? "أسئلة الاختيار المتعدد" : "Review Questions (MCQ)") : key);
 show("materialsPage");
 $("fileSearchInput").value = "";
 $("uploadCardSection").style.display = key === "Questions" ? "none" : "block";
 $("fileSearchInput").style.display = key === "Questions" ? "none" : "block";

 const list = $("fileList");

 if(key === "Questions"){
  list.replaceChildren();
  const qList = QUESTIONS_DATA[subject] || [];
  if(!qList.length){
   list.append(el("div","empty","📂 "+(isAr ? "لا توجد أسئلة متاحة حالياً." : "No questions available.")));
   return;
  }
  const wrap = el("div","mcq-wrap");
  const table = document.createElement("table");
  table.className = "mcq-table";
  const thead = document.createElement("thead");
  const hr = document.createElement("tr");
  ["#", isAr ? "السؤال" : "Question", isAr ? "الخيارات" : "Options"].forEach(t => hr.append(el("th","",t)));
  thead.append(hr);
  table.append(thead);

  const tbody = document.createElement("tbody");
  qList.forEach((item, index) => {
   const tr = document.createElement("tr");
   const tdNum = el("td","",String(index + 1));
   tdNum.style.fontWeight = "bold"; tdNum.style.width = "50px";
   const tdQ = el("td","",item.q[lang] || item.q.en || item.q.ar);
   tdQ.style.fontWeight = "bold";
   const tdOpts = document.createElement("td");
   const optsArray = item.options[lang] || item.options.en || item.options.ar;
   optsArray.forEach((opt, optIdx) => {
    const btn = el("button","option-btn",opt);
    btn.addEventListener("click", () => {
     const allBtns = tdOpts.querySelectorAll(".option-btn");
     allBtns.forEach(b => b.disabled = true);
     if(optIdx === item.correct){
      btn.classList.add("correct");
     }else{
      btn.classList.add("wrong");
      allBtns[item.correct].classList.add("correct");
     }
    });
    tdOpts.append(btn);
   });
   tr.append(tdNum, tdQ, tdOpts);
   tbody.append(tr);
  });
  table.append(tbody);
  wrap.append(table);
  list.append(wrap);
  return;
 }

 list.replaceChildren(el("div","empty",isAr ? "جارٍ التحميل..." : "Loading..."));
 let data=[];
 try{ data = await loadFiles(); }
 catch(e){ console.error(e); list.replaceChildren(el("div","empty",isAr ? "تعذر تحميل الملفات." : "Could not load files.")); return; }
 if(material!==key) return;
 list.replaceChildren();
 if(!data.length){ list.append(el("div","empty","📂 "+(isAr ? "لا توجد ملفات بعد." : "No files available yet."))); return; }
 data.forEach(f=>{
  const row=el("div","file"); row.dataset.name = f.name.toLowerCase();
  const b=el("button","",isAr ? "فتح" : "Open");
  b.addEventListener("click",()=>window.open(f.url,"_blank","noopener"));
  row.append(el("span","","📄 "+f.name), b); list.append(row);
 });
}

function filterFiles(){
 const q = $("fileSearchInput").value.toLowerCase();
 document.querySelectorAll("#fileList .file").forEach(row=>{
  row.style.display = row.dataset.name.includes(q) ? "" : "none";
 });
}
function searchSubjects(){
 const q=$("searchInput").value.toLowerCase();
 document.querySelectorAll(".subject").forEach(s=>{
  s.style.display = s.querySelector("h3").textContent.toLowerCase().includes(q) ? "" : "none";
 });
}
function applyLang(){
 document.documentElement.lang=lang; document.documentElement.dir=lang==="ar"?"rtl":"ltr";
 document.querySelectorAll("[data-en]").forEach(e=>{
  const v=e.dataset[lang];
  if(e.dataset.ph) e.placeholder=v; else e.innerHTML=v;
 });
 $("navLang").textContent = lang==="ar"?"English":"عربي";
 $("sem3Btn").textContent = lang==="ar" ? "📗 السمستر الثالث" : "📗 Semester 3";
 $("sem2Btn").textContent = lang==="ar" ? "📘 السمستر الثاني" : "📘 Semester 2";
 updateSemesterTitle();
 renderSubjects();
 if(subject && $("subjectPage").style.display === "block") openSubject(subject, true);
 if(material === "Questions" && $("materialsPage").style.display === "block") openMaterial("Questions");
}

/* ===== Study Tasks ===== */
const TASKS_KEY = "study_tasks";
function loadTasks(){
 try{ return JSON.parse(localStorage.getItem(TASKS_KEY)) || []; }
 catch{ return []; }
}
function saveTasks(list){
 try{ localStorage.setItem(TASKS_KEY, JSON.stringify(list)); }
 catch(e){ console.error("Could not save tasks:", e); }
}
function renderTasks(){
 const list = loadTasks();
 const ul = $("taskList"); ul.replaceChildren();
 $("taskEmpty").style.display = list.length ? "none" : "block";
 list.forEach((task,i)=>{
  const li = el("li", task.done ? "done" : "");
  const span = el("span","",task.text);
  span.addEventListener("click", ()=>toggleTask(i));
  const del = el("button","","✕");
  del.addEventListener("click", ()=>deleteTask(i));
  li.append(span, del); ul.append(li);
 });
}
function addTask(){
 const input = $("taskInput");
 const text = input.value.trim();
 if(!text) return;
 const list = loadTasks();
 list.push({text, done:false});
 saveTasks(list);
 input.value = "";
 renderTasks();
}
function toggleTask(i){
 const list = loadTasks();
 list[i].done = !list[i].done;
 saveTasks(list); renderTasks();
}
function deleteTask(i){
 const list = loadTasks();
 list.splice(i,1);
 saveTasks(list); renderTasks();
}

/* ===== Dark mode ===== */
const DARK_KEY = "students_is_dark_mode";
function applyDarkMode(enabled){
 document.body.classList.toggle("dark", enabled);
 $("navDark").textContent = enabled ? "☀️" : "🌙";
 try { localStorage.setItem(DARK_KEY, enabled ? "1" : "0"); }
 catch(e) { console.error("Could not save dark-mode preference:", e); }
}
function restoreDarkMode(){
 try { applyDarkMode(localStorage.getItem(DARK_KEY) === "1"); }
 catch(e) { applyDarkMode(false); }
}

/* ===== Events ===== */
$("navHome").onclick=()=>show("homePage");
$("navTasks").onclick=()=>{ show("tasksPage"); renderTasks(); };
$("navAbout").onclick=()=>show("aboutPage");
$("navDark").onclick=()=>applyDarkMode(!document.body.classList.contains("dark"));
$("navLang").onclick=()=>{ lang = lang==="en"?"ar":"en"; applyLang(); };
$("backHome").onclick=()=>show("homePage", true);
$("backSubject").onclick=()=>openSubject(subject, true);
$("searchInput").addEventListener("input",searchSubjects);
$("fileSearchInput").addEventListener("input",filterFiles);
$("examSaveBtn").addEventListener("click",()=>{
 const val = $("examDate").value;
 if(!val) return;
 const dates = loadExamDates();
 dates[subject] = val;
 saveExamDates(dates);
 renderExamCountdown();
});
$("examClearBtn").addEventListener("click",()=>{
 const dates = loadExamDates();
 delete dates[subject];
 saveExamDates(dates);
 renderExamCountdown();
});
$("addTaskBtn").addEventListener("click",addTask);
$("uploadBtn").addEventListener("click",uploadFile);
$("taskInput").addEventListener("keydown", e=>{ if(e.key==="Enter") addTask(); });

/* Secret admin shortcut: tap the footer logo 5 times */
