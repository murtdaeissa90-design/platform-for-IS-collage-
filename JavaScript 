const EXAM_KEY = "exam_dates";
function loadExamDates(){
 try{ return JSON.parse(localStorage.getItem(EXAM_KEY)) || {}; }
 catch{ return {}; }
}
function saveExamDates(obj){
 try{ localStorage.setItem(EXAM_KEY, JSON.stringify(obj)); }
 catch(e){ console.error("Could not save exam date:", e); }
}
function renderExamCountdown(){
 const dates = loadExamDates();
 const dateStr = dates[subject] || "";
 $("examDate").value = dateStr;
 const card = $("examDate").closest(".exam-card");
 const textEl = $("examText");
 if(!dateStr){
  textEl.textContent = lang==="ar" ? "⏳ لم يُحدد موعد امتحان" : "⏳ No exam date set";
  card.classList.remove("urgent");
  return;
 }
 const today = new Date(); today.setHours(0,0,0,0);
 const examDay = new Date(dateStr+"T00:00:00");
 const days = Math.round((examDay - today) / 86400000);
 card.classList.toggle("urgent", days>=0 && days<=2);
 if(days < 0) textEl.textContent = lang==="ar" ? "✅ انتهى موعد هذا الامتحان" : "✅ This exam date has passed";
 else if(days === 0) textEl.textContent = lang==="ar" ? "🚨 الامتحان اليوم!" : "🚨 Exam is today!";
 else textEl.textContent = (lang==="ar" ? "⏳ باقي "+days+" يوم على الامتحان" : "⏳ "+days+" day(s) left until the exam");
}

