/* ===== Storage ===== */
async function listFiles(path){
 const {data,error} = await sb.storage.from(BUCKET).list(path,{limit:200,sortBy:{column:"name",order:"asc"}});
 if(error) throw error;
 return (data||[]).filter(f => f.id && f.name !== ".emptyFolderPlaceholder").map(f => ({
  name: f.name.replace(/\.[^.]+$/,""),
  url: sb.storage.from(BUCKET).getPublicUrl(path+"/"+f.name).data.publicUrl
 }));
}
async function loadFiles(){
 const key = subject+"|"+material;
 if(cache[key]) return cache[key];
 const fixed = (STATIC[subject] && STATIC[subject][material]) || [];
 let listed = [], approved = [];
 if(!STORAGE_KEY.startsWith("PASTE")){
  try{
   const folder = folderOf(subject);
   listed = await listFiles(folder+"/"+material);
   if(material==="Lectures") listed = listed.concat(await listFiles(folder));
  }catch(e){ console.error(e); if(!fixed.length && !sb) throw e; }
  try{
   const {data,error} = await sb.from("submissions").select("name,path").eq("subject",subject).eq("material",material).eq("approved",true);
   if(!error) approved = (data||[]).map(r=>({name:r.name,url:r.path}));
  }catch(e){ console.error("Could not load approved submissions:",e); }
 }
 const all = fixed.concat(listed, approved);
 const seen = new Set(); const out = [];
 all.forEach(f=>{ if(!seen.has(f.url)){ seen.add(f.url); out.push(f); } });
 return cache[key] = out;
}

/* ===== Student upload ===== */
async function uploadFile(){
 const input = $("uploadInput"), btn = $("uploadBtn");
 const file = input.files[0];
 if(!file) return;
 if(STORAGE_KEY.startsWith("PASTE")){
  note(lang==="ar"?"الرفع غير مفعّل بعد.":"Upload is not enabled yet.", true); return;
 }
 btn.disabled = true;
 note(lang==="ar"?"جارٍ الرفع...":"Uploading...", false);
 try{
  const safeName = file.name.replace(/[^\w.\-]+/g,"_");
  const path = "pending/"+Date.now()+"_"+safeName;
  const {error: upErr} = await sb.storage.from(BUCKET).upload(path, file);
  if(upErr) throw upErr;
  const url = sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
  const {error: insErr} = await sb.from("submissions").insert([{
   subject, material, name: file.name.replace(/\.[^.]+$/,"").slice(0,120), path: url, approved:false
  }]);
  if(insErr) throw insErr;
  note(lang==="ar"?"تم الرفع، سيظهر بعد موافقة الأدمن ✅":"Uploaded. It will appear after admin approval ✅", false);
  input.value = "";
 }catch(e){
  console.error(e);
  note(lang==="ar"?"تعذر رفع الملف.":"Could not upload the file.", true);
 }finally{
  btn.disabled = false;
 }
}
function note(text, err){
 const m = $("uploadMsg");
 m.textContent = text; m.className = "msg"+(err?" err":""); m.style.display = "block";
 setTimeout(()=>{ m.style.display = "none"; }, 6000);
}

