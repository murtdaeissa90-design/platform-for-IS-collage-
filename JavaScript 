  thead.innerHTML = `<tr><th>#</th><th>${isAr ? "السؤال" : "Question"}</th><th>${isAr ? "الخيارات" : "Options"}</th></tr>`;
  table.appendChild(thead);
  
  const tbody = document.createElement("tbody");
  qList.forEach((item, index) => {
   const tr = document.createElement("tr");
   
   const tdNum = document.createElement("td");
   tdNum.textContent = index + 1;
   tdNum.style.fontWeight = "bold";
   tdNum.style.width = "50px";
   
   const tdQ = document.createElement("td");
   tdQ.textContent = item.q[lang] || item.q.en || item.q.ar;
   tdQ.style.fontWeight = "bold";
   
   const tdOpts = document.createElement("td");
   const optsArray = item.options[lang] || item.options.en || item.options.ar;
   
   optsArray.forEach((opt, optIdx) => {
    const btn = document.createElement("button");
    btn.className = "option-btn";
    btn.textContent = opt;
    btn.onclick = () => {
     const allBtns = tdOpts.querySelectorAll(".option-btn");
     allBtns.forEach(b => b.disabled = true);
     
     if(optIdx === item.correct) {
      btn.style.background = "#d4edda";
      btn.style.color = "#155724";
      btn.style.borderColor = "#c3e6cb";
     } else {
      btn.style.background = "#f8d7da";
      btn.style.color = "#721c24";
      btn.style.borderColor = "#f5c6cb";
      allBtns[item.correct].style.background = "#d4edda";
      allBtns[item.correct].style.color = "#155724";
      allBtns[item.correct].style.borderColor = "#c3e6cb";
     }
    };
    tdOpts.appendChild(btn);
   });
   
   tr.append(tdNum, tdQ, tdOpts);
   tbody.appendChild(tr);
  });
  table.appendChild(tbody);
  list.append(table);
  return;
 }

 list.replaceChildren(el("div","empty",isAr ? "جارٍ التحميل..." : "Loading..."));
 let data=[];
 try{ data = await loadFiles(); }
 catch(e){ console.error(e); list.replaceChildren(el("div","empty",isAr ? "تعذر تحميل الملفات." : "Could not load files.")); return; }
 if(material!==key) return; 
 list.replaceChildren();
 if(!data.length){ list.append(el("div","empty","📂 "+(isAr ? "لا توجد ملفات بعد." : "No files available yet."))); return; }
 data.forEach(f=>{
